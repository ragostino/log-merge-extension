import * as vscode from 'vscode';
import { mergeLogs, MergedLine } from './merge';

const tokenTypesLegend = Array.from(
  { length: 120 },
  (_, i) => `file${Math.floor(i / 6)}_sev${i % 6}`
);

const tokenTypes = new Map<string, number>();
tokenTypesLegend.forEach((t, i) => tokenTypes.set(t, i));

export const legend = new vscode.SemanticTokensLegend(tokenTypesLegend, []);

/*
const legend = new vscode.SemanticTokensLegend(
    Array.from({ length: 120 }, (_, i) => `file${Math.floor(i/6)}_sev${i%6}`)
)
*/


let mergedLines: MergedLine[] = [];
let fileRootColors = new Map<string, string>();

const baseColors = [
    "#FF0000", "#FF7F00", "#FFFF00", "#00FF00", "#00FFFF",
    "#0000FF", "#8B00FF", "#FF00FF", "#FF1493", "#00BFFF",
    "#7FFF00", "#FFD700", "#FF4500", "#2E8B57", "#708090",
    "#8B4513", "#556B2F", "#9932CC", "#DC143C", "#20B2AA"
];

function shadeColor(hex: string, severityIndex: number): string {
    const factor = 1 - (severityIndex * 0.12);
    const num = parseInt(hex.slice(1), 16);

    let r = Math.floor(((num >> 16) & 255) * factor);
    let g = Math.floor(((num >> 8) & 255) * factor);
    let b = Math.floor((num & 255) * factor);

    return `#${r.toString(16).padStart(2,'0')}${g.toString(16).padStart(2,'0')}${b.toString(16).padStart(2,'0')}`;
}

function getColorForRoot(root: string): string {
    if (!fileRootColors.has(root)) {
        const index = fileRootColors.size % baseColors.length;
        fileRootColors.set(root, baseColors[index]);
    }
    return fileRootColors.get(root)!;
}

export function activate(context: vscode.ExtensionContext) {

    const disposable = vscode.commands.registerCommand(
        'logMerge.mergeLogs',
        async () => {
            const files = await vscode.window.showOpenDialog({
                canSelectMany: true,
                filters: { 'Log files': ['log', 'txt'] }
            });

            if (!files) return;

            const result = await mergeLogs(files);
            mergedLines = result.lines;

            //
            // 🔥 Documento virtuale (untitled) → niente salvataggio automatico
            //
            const uri = vscode.Uri.parse('untitled:merged-output', false);

            let doc = await vscode.workspace.openTextDocument(uri);
            doc = await vscode.languages.setTextDocumentLanguage(doc, 'mergedlog');

            //
            // 🔥 Inserisci il contenuto del merge
            //
            const edit = new vscode.WorkspaceEdit();
            edit.insert(uri, new vscode.Position(0, 0), result.text);
            await vscode.workspace.applyEdit(edit);

            //
            // 🔥 Mostra il documento
            //
            await vscode.window.showTextDocument(doc);

            //
            // 🔥 Applica decoratori (marcatori inizio/fine file)
            //
            applyFileBoundaryDecorators();
        }
    );

    context.subscriptions.push(disposable);

    //
    // 🔥 Provider semantic tokens
    //
    context.subscriptions.push(
        vscode.languages.registerDocumentSemanticTokensProvider(
            { language: 'mergedlog' },
            new LogSemanticTokenProvider(),
            legend
        )
    );

    //
    // 🔥 Tooltip con nome file e riga originale
    //
    context.subscriptions.push(
        vscode.languages.registerHoverProvider('mergedlog', {
            provideHover(document, position) {
                const line = position.line;
                const info = mergedLines[line];
                if (!info) return;

                return new vscode.Hover(
                    `File: **${info.root}**\nRiga nel file: ${info.fileLineIndex + 1}`
                );
            }
        })
    );
}

export function deactivate() {}



class LogSemanticTokenProvider implements vscode.DocumentSemanticTokensProvider {

    provideDocumentSemanticTokens(
        document: vscode.TextDocument
    ): vscode.ProviderResult<vscode.SemanticTokens> {

        console.log("Semantic provider chiamato per:", document.languageId, document.uri.toString());

        const builder = new vscode.SemanticTokensBuilder(legend);

        for (let line = 0; line < document.lineCount; line++) {

            const info = mergedLines[line];
            if (!info) continue;

            const tokenName = `file${info.fileIndex}_sev${info.severityIndex}`;
            builder.push(line, 0, document.lineAt(line).text.length, tokenTypes.get(tokenName)!, 0);

            /*
            const tokenIndex = info.fileIndex * 6 + info.severityIndex;

            builder.push(
                line,
                0,
                document.lineAt(line).text.length,
                tokenIndex
            ); */

        }

        return builder.build();
    }
}

//
// 🔥 Decoratore: marcatori di inizio/fine file
//    - NON modifica il testo
//    - NON interferisce con semantic tokens
//    - Colora solo il prefisso aggiunto dal decoratore
//
function applyFileBoundaryDecorators() {
    const editor = vscode.window.activeTextEditor;
    if (!editor) return;

    const decorations: vscode.DecorationOptions[] = [];

    for (let i = 0; i < mergedLines.length; i++) {
        const info = mergedLines[i];

        decorations.push({
            range: new vscode.Range(i, 0, i, 0),
            renderOptions: {
                before: {
                    contentText: info.isFirst ? "> " :
                                 info.isLast  ? "< " :
                                                "- ",
                    color: getColorForRoot(info.root),
                    margin: "0 4px 0 0"
                }
            }
        });
    }

    const decorationType = vscode.window.createTextEditorDecorationType({});
    editor.setDecorations(decorationType, decorations);
}
