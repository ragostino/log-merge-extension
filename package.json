{
  "name": "log-merge-extension",
  "displayName": "Log Merge Extension",
  "description": "Unisce più file di log ordinandoli per timestamp, colorando per file e gravità, e marcando inizio/fine file.",
  "version": "0.0.1",
  "publisher": "ragostino",
  "engines": {
    "vscode": "^1.90.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ragostino/log-merge-extension.git"
  },

  "main": "./out/extension.js",

  "contributes": {

    "themes": [
        {
          "label": "Merged Log Theme",
          "uiTheme": "vs-dark",
          "path": "./themes/mergedlog-theme.json"
        }
      ],
      
    "languages": [
      {
        "id": "mergedlog",
        "aliases": ["Merged Log"],
        "extensions": [".mergedlog"]
      }
    ],

    "grammars": [
      {
        "language": "mergedlog",
        "scopeName": "source.mergedlog",
        "path": "./syntaxes/mergedlog.tmLanguage.json"
      }
    ],

    "semanticHighlighting": true,

    "configurationDefaults": {
      "[mergedlog]": {
        "editor.semanticHighlighting.enabled": true
      }
    },

    "commands": [
      {
        "command": "logMerge.mergeLogs",
        "title": "Merge Logs"
      },
      {
        "command": "logMerge.filterSeverity",
        "title": "Log Merge: Filter Severity"
      },
      {
        "command": "logMerge.filterFiles",
        "title": "Log Merge: Filter Files"
      }
    ]

  },

  "files": [
      "out/**",
      "themes/**",
      "syntaxes/**",
      "package.json",
      "README.md",
      "LEGGIMI.txt",
      "LICENSE"
  ],

  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },

  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0"
  }
}
